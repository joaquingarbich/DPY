  {
    "id": "f_api",
    "type": "function",
    "z": "tab_secador",
    "name": "api",
    "func": "const ruta = `${msg.req.method} ${msg.req.route.path}`;\nconst r = await global.get('secador').http(ruta, msg.req);\nmsg.statusCode = r.status;\nmsg.headers = r.headers;\nmsg.payload = r.body;\nconst config = r.mqtt ? { topic: r.mqtt.topic, payload: r.mqtt.payload, qos: r.mqtt.qos, retain: r.mqtt.retain } : null;\nreturn [msg, config];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 490,
    "y": 440,
    "wires": [
