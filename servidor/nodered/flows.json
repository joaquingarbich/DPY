    "name": "telemetría",
    "topic": "secador/+/telemetria",
    "qos": "1",
    "datatype": "json",
    "broker": "broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 130,
    "y": 80,
    "wires": [
      [
        "f_tel"
      ]
    ]
  },
  {
    "id": "f_tel",
    "type": "function",
    "z": "tab_secador",
    "name": "ingresar telemetría",
    "func": "const r = await global.get('secador').ingresarTelemetria(msg.payload);\nif (!r.ok) node.warn(`rechazado: ${r.motivo}`);\nnode.status(r.ok\n  ? { fill: 'green', shape: 'dot', text: r.duplicado ? 'duplicado' : `${msg.payload.lote} seq ${msg.payload.seq}` }\n  : { fill: 'red', shape: 'ring', text: r.motivo });\nreturn null;",
    "outputs": 0,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 350,
    "y": 80,
    "wires": []
  },
