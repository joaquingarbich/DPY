    "name": "ingresar evento",
    "func": "const r = await global.get('secador').ingresarEvento(msg.payload);\nif (!r.ok) node.warn(`evento rechazado: ${r.motivo}`);\nnode.status({ fill: r.ok ? 'blue' : 'red', shape: 'dot', text: `${msg.payload.tipo}` });\nreturn null;",
