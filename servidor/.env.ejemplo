# Copiar como .env y completar. No subir .env al repositorio.

# Dominio que apunta a la máquina virtual (registro A). Caddy saca el certificado solo.
DOMINIO=secador.ejemplo.pe

# MongoDB Atlas → Connect → Drivers (usuario con permiso readWrite en "secador").
# Pegue aquí la cadena que da Atlas, con su usuario y su clave: mongodb+srv://<usuario>:<clave>@<cluster>/...
MONGODB_URI=
MONGODB_DB=secador

# HiveMQ Cloud → Overview (sin mqtts:// ni puerto) y un usuario propio del servidor
MQTT_HOST=xxxxxxxx.s1.eu.hivemq.cloud
MQTT_USUARIO=servidor
MQTT_CLAVE=cambiar

# Claves de la API de Node-RED y de la página /app:
#   grafana: solo lee (lo usa Grafana)   operario: entra a /app y solo ve
#   tecnico: entra a /app, ve y además carga gravimetría y cambia la configuración
API_GRAFANA_CLAVE=cambiar
API_OPERARIO_CLAVE=cambiar
API_TECNICO_CLAVE=cambiar

# Editor de Node-RED (/editor), usuario admin. Hash con: docker compose run --rm nodered npx node-red admin hash-pw
# Docker Compose interpreta "$": escriba cada $ del hash como $$ (ej. $$2b$$08$$...).
NODE_RED_EDITOR_HASH=

# Grafana (usuario admin)
GF_ADMIN_CLAVE=cambiar

# Bot de Telegram (@BotFather) y chats que reciben las alertas
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_OPERARIO=123456789
TELEGRAM_CHAT_GRUPO=-1001234567890
