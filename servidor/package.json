{
  "name": "secador-servidor",
  "private": true,
  "description": "Servidor del secador solar: Node-RED, MongoDB y Grafana. Este package.json es solo para desarrollo y pruebas locales.",
  "scripts": {
    "test": "node --test",
    "dev": "node dev/levantar.js",
    "simular": "node dev/simulador.js",
    "verificar-nube": "node --env-file=.env herramientas/verificar-nube.js",
    "servidor": "node --env-file=.env node_modules/node-red/red.js --settings nodered/settings.js --userDir .nodered-local"
  },
  "dependencies": {
    "mongodb": "^7.8.0"
  },
  "devDependencies": {
    "aedes": "^1.2.0",
    "mongodb-memory-server": "^11.3.0",
    "mqtt": "^5.16.1",
    "node-red": "^5.0.9"
  }
}
